# Database
DATABASE_URL="postgresql://user:password@localhost:5432/invoicehub?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# SMTP
# Sans SMTP réel configuré, InvoiceHub fonctionne en mode démonstration :
# les emails sont générés dans server/preview-emails/ et les factures passent
# quand même au statut "Envoyée", ce qui permet de tester tout le flux.
SMTP_HOST="smtp.votre-fournisseur.com"
SMTP_PORT=587
SMTP_USER="your-email@example.com"
SMTP_PASS="your-email-password"

# Client URL (for links in emails, Stripe redirect, etc.)
CLIENT_URL="http://localhost:5173"

# Server
PORT=3000

# Cron des relances automatiques (format cron standard, défaut: tous les jours à 08h00)
REMINDER_CRON="0 8 * * *"
